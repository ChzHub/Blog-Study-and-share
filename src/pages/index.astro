---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getPosts, postUrl, formatDate, readingTime, isDemo } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <section class="author-intro shell" aria-label="关于作者">
    <a class="author-intro-link" href="/about/">
      <div class="author-intro-copy">
        <span class="author-intro-label">ABOUT THE AUTHOR <span aria-hidden="true">/</span> 关于作者</span>
        <h1>你好，我是{site.author.name}。</h1>
        <p>{site.author.introduction}</p>
        <span class="author-intro-more">了解更多 <Icon name="arrow" size={16} /></span>
      </div>
      <span class="author-avatar" aria-hidden="true">记<span class="author-avatar-dot"></span></span>
    </a>
  </section>
  <section class="home-articles shell" aria-labelledby="latest-label">
    <div class="home-articles-heading"><div><span class="eyebrow">LATEST ARTICLES / 最近更新</span><h2 id="latest-label">{site.content.homeHeading}<span>.</span></h2></div><a class="home-all-link" href="/posts/">全部文章 <Icon name="arrow" size={16} /></a></div>
    {posts.length ? <div class="home-article-list">{posts.slice(0, 6).map(post => <article class="home-article">
      <a class="home-article-cover" href={postUrl(post)} tabindex="-1" aria-hidden="true"><Cover post={post} /></a>
      <div class="home-article-copy"><div class="home-article-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{readingTime(post.body)} 分钟阅读</span>{isDemo(post) && <span>示例内容</span>}</div><h3><a href={postUrl(post)}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="home-article-bottom"><span>{post.data.tags.join(' / ')}</span><a href={postUrl(post)} aria-label={`阅读：${post.data.title}`}><Icon name="arrow" size={18} /></a></div></div>
    </article>)}</div> : <div class="empty-state"><h3>第一篇手记，正在酝酿。</h3><p>等一个想法，慢慢长成文章。</p></div>}
    {posts.length > 0 && <div class="home-list-end"><a href="/posts/">浏览全部文章 <Icon name="arrow" size={16} /></a><span>保持好奇，下一篇见。</span></div>}
  </section>
</Base>
