---
interface Props { current: number; total: number; }
const { current, total } = Astro.props;
const url = (page: number) => page === 1 ? '/posts/' : `/posts/page/${page}/`;
---
{total > 1 && <nav class="pagination" aria-label="文章分页">
  {current > 1 ? <a href={url(current - 1)} rel="prev">← 上一页</a> : <span />}
  <span>第 {current} / {total} 页</span>
  {current < total ? <a href={url(current + 1)} rel="next">下一页 →</a> : <span />}
</nav>}
